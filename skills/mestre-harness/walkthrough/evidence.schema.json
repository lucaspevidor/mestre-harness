{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git walkthrough evidence design v1",
  "description": "Design contract only. Cross-record integrity, hashes, Git facts, ranges, secrecy, and review provenance require semantic validation by future tooling.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "repository_label": {
      "type": "string",
      "minLength": 1
    },
    "object_format": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "final_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "base_selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed_base_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "reviewed_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "verdict": {
          "enum": [
            "no-blocking-findings-in-inspected-scope",
            "changes-requested",
            "incomplete-evidence"
          ]
        },
        "report_summary": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "coverage_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "reviewed_base_sha",
        "reviewed_sha",
        "verdict",
        "report_summary",
        "unresolved_findings",
        "coverage_limits"
      ]
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "clean",
            "excluded-changes"
          ]
        },
        "excluded_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "state",
        "excluded_changes"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$"
          },
          "status": {
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed",
              "copied",
              "type-changed"
            ]
          },
          "old_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "new_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "old_blob_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_blob_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "old_mode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-7]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_mode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-7]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{2,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "status",
          "old_path",
          "new_path",
          "old_blob_id",
          "new_blob_id",
          "old_mode",
          "new_mode",
          "evidence_ids"
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]{2,}$"
              },
              "kind": {
                "const": "source"
              },
              "file_id": {
                "type": "string",
                "pattern": "^F[0-9]{2,}$"
              },
              "side": {
                "enum": [
                  "base",
                  "final"
                ]
              },
              "revision": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "blob_id": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "lines": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              },
              "text": {
                "type": "string"
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "kind",
              "file_id",
              "side",
              "revision",
              "blob_id",
              "lines",
              "text",
              "text_sha256"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]{2,}$"
              },
              "kind": {
                "const": "diff"
              },
              "file_id": {
                "type": "string",
                "pattern": "^F[0-9]{2,}$"
              },
              "base_sha": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "final_sha": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "hunk_id": {
                "type": "string",
                "minLength": 1
              },
              "old_range": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "start",
                  "count"
                ]
              },
              "new_range": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "start",
                  "count"
                ]
              },
              "text": {
                "type": "string"
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "kind",
              "file_id",
              "base_sha",
              "final_sha",
              "hunk_id",
              "old_range",
              "new_range",
              "text",
              "text_sha256"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]{2,}$"
              },
              "kind": {
                "const": "check"
              },
              "file_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F[0-9]{2,}$"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "blocked",
                  "not-run"
                ]
              },
              "tested_revision": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "applies_to_final": {
                "type": "boolean"
              },
              "applicability_evidence": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "captured_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text": {
                "type": "string"
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "coverage_limits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "kind",
              "file_ids",
              "method",
              "status",
              "tested_revision",
              "applies_to_final",
              "applicability_evidence",
              "exit_code",
              "captured_at",
              "text",
              "text_sha256",
              "coverage_limits"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]{2,}$"
              },
              "kind": {
                "const": "omission"
              },
              "file_id": {
                "type": "string",
                "pattern": "^F[0-9]{2,}$"
              },
              "reason": {
                "enum": [
                  "secret-redaction",
                  "binary",
                  "submodule",
                  "symlink",
                  "oversized",
                  "unsupported-encoding",
                  "other"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "essential_evidence_missing": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "file_id",
              "reason",
              "explanation",
              "essential_evidence_missing"
            ]
          }
        ]
      },
      "minItems": 0
    },
    "redaction_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "coverage_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "repository_label",
    "object_format",
    "base_sha",
    "final_sha",
    "base_selection_reason",
    "review",
    "worktree",
    "files",
    "evidence",
    "redaction_notes",
    "coverage_limits"
  ]
}
