{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git walkthrough narrative design v1",
  "description": "Plain-text narrative and opaque references only. No code, raw HTML, arbitrary file access, or executable presentation fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "final_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{2,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "deeper_explanation": {
            "type": "string"
          },
          "deeper_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{2,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "before",
          "after",
          "why",
          "evidence_ids",
          "deeper_explanation",
          "deeper_evidence_ids"
        ]
      },
      "minItems": 0
    },
    "file_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$"
          },
          "category": {
            "enum": [
              "explained",
              "mechanical",
              "generated",
              "omitted"
            ]
          },
          "section_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file_id",
          "category",
          "section_ids",
          "reason"
        ]
      },
      "minItems": 0
    },
    "test_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^E[0-9]{2,}$"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "explanation"
        ]
      },
      "minItems": 0
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "evidence_sha256",
    "base_sha",
    "final_sha",
    "title",
    "summary",
    "sections",
    "file_coverage",
    "test_notes",
    "tradeoffs",
    "limitations",
    "unresolved_findings"
  ]
}
